# Development Dockerfile for home-app with hot reload
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including dev dependencies)
RUN npm install

# Copy source code (will be overridden by volume mount)
COPY . .

# Expose port 3000
EXPOSE 3000

# Start webpack dev server
CMD ["npm", "start"]
